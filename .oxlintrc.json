{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "react", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "off",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ],
    "eslint/func-style": ["error", "expression"],
    "oxc/no-barrel-file": [
      "error",
      {
        "threshold": 0
      }
    ],
    "import/no-default-export": "error",
    "eslint/eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "eslint/no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/messaging/src/redis-streams.ts", "**/web/src/lib/api.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/apps/*-api/src/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nestjs/common",
                "importNames": [
                  "HttpException",
                  "BadRequestException",
                  "UnauthorizedException",
                  "ForbiddenException",
                  "NotFoundException",
                  "ConflictException",
                  "UnprocessableEntityException",
                  "InternalServerErrorException",
                  "NotAcceptableException",
                  "GoneException"
                ],
                "message": "에러 코드가 없는 응답이 된다. 각 앱의 errors.ts 로 던진다 (예: scmError('UNIT_NOT_FOUND'))."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/apps/*-api/src/domains/*/domain/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nestjs/common",
                "importNames": [
                  "HttpException",
                  "BadRequestException",
                  "UnauthorizedException",
                  "ForbiddenException",
                  "NotFoundException",
                  "ConflictException",
                  "UnprocessableEntityException",
                  "InternalServerErrorException",
                  "NotAcceptableException",
                  "GoneException"
                ],
                "message": "에러 코드가 없는 응답이 된다. 각 앱의 errors.ts 로 던진다 (예: scmError('UNIT_NOT_FOUND'))."
              }
            ],
            "patterns": [
              {
                "regex": "^@nestjs/",
                "message": "domain 은 Nest 를 모른다. docs/architecture-rules.md 의 \"의존 방향\"."
              },
              {
                "regex": "^drizzle-orm(/|$)",
                "message": "domain 은 Drizzle 을 직접 쓰지 않는다. 쿼리는 infra 의 repository 에 둔다. docs/architecture-rules.md 의 \"의존 방향\"."
              },
              {
                "regex": "^mysql2(/|$)",
                "message": "domain 은 DB 드라이버를 모른다. docs/architecture-rules.md 의 \"의존 방향\"."
              },
              {
                "regex": "^@repo/(db-kit|nest-kit|messaging)(/|$)",
                "message": "domain 은 순수해야 한다. @repo/contracts 의 값 타입만 가져올 수 있다. docs/architecture-rules.md 의 \"의존 방향\"."
              },
              {
                "regex": "^\\.\\.?/(.*/)?(application|infra|usecases|presentation)/",
                "message": "domain 은 다른 레이어를 import 하지 않는다. docs/architecture-rules.md 의 \"의존 방향\"."
              },
              {
                "regex": "^\\.\\.?/(.*/)?db/schema(\\.js)?$",
                "message": "domain 은 테이블 정의를 모른다. db/schema 는 infra 만 import 한다. docs/architecture-rules.md 의 \"의존 방향\"."
              },
              {
                "regex": "^\\.\\.?/(.*/)?domains/",
                "message": "도메인은 서로를 import 하지 않는다. 필요한 데이터는 usecase 가 읽어서 넘긴다. docs/architecture-rules.md 의 \"의존 방향\"."
              }
            ]
          }
        ]
      }
    },
