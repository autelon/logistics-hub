{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "react", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "off",
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "typescript/no-extraneous-class": [
      "warn",
      {
        "allowWithDecorator": true
      }
    ],
    "eslint/func-style": ["error", "expression"],
    "oxc/no-barrel-file": [
      "error",
      {
        "threshold": 0
      }
    ],
    "import/no-default-export": "error",
    "eslint/eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "eslint/no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/messaging/src/redis-streams.ts", "**/web/src/lib/api.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/apps/*-api/src/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nestjs/common",
                "importNames": [
                  "HttpException",
                  "BadRequestException",
                  "UnauthorizedException",
                  "ForbiddenException",
                  "NotFoundException",
                  "ConflictException",
                  "UnprocessableEntityException",
                  "InternalServerErrorException",
                  "NotAcceptableException",
                  "GoneException"
                ],
                "message": "에러 코드가 없는 응답이 된다. 각 앱의 errors.ts 로 던진다 (예: scmError('UNIT_NOT_FOUND'))."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/drizzle/**", "**/routeTree.gen.ts"]
}
